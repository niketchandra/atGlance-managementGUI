# AtGlance CE - docker compose settings. Copy to .env next to
# docker-compose.yml. install.sh writes this file for you.

# Image tag to run (latest, or a release such as 1.2.1).
ATGLANCE_VERSION=latest

# Host ports.
APP_PORT=8000
GATEWAY_PORT=8002

# MySQL passwords. Change both before the first start; they are fixed into
# the database volume on first boot.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
