# AtGlance CE - docker compose settings. Copy to .env next to
# docker-compose.yml. atglance-installer.sh and atglance_update.sh write this
# file for you, with random passwords.

# Image tag to run (latest, or a release such as 2.0.0).
ATGLANCE_VERSION=latest

# Host ports.
APP_PORT=8000
GATEWAY_PORT=8002

# Passwords. Required: there are no defaults, and MySQL does not start without them.
# Use long random values, for example: openssl rand -base64 32 | tr -dc 'A-Za-z0-9'
# The two MySQL passwords are fixed into the database volume on first boot.
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# Image registry and namespace. Default: atglance on Docker Hub.
ATGLANCE_REGISTRY=atglance
